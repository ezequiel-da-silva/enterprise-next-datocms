# @vercel/speed-insights declares optional peers (@sveltejs/kit, svelte, vue, nuxt) whose own peers
# (vite 8) conflict with the vite 6 pulled by vitest / @vitejs/plugin-react. They are optional and unused
# here, so skip peer resolution. Without this, `npm ci` rejects the lock file (ERESOLVE / out of sync).
legacy-peer-deps=true
