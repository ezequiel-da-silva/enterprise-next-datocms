#!/bin/sh
echo "🔍 Executando validação completa antes do push..."

# 1. Verifica tipos GraphQL vs SDL versionado (offline)
npm run codegen:check || { echo "❌ GraphQL gerado desactualizado. Rode 'npm run codegen' (ou 'npm run codegen:from-dato' se o schema Dato mudou) e inclua generated/."; exit 1; }

# 2. Verificação de tipos estritos do TypeScript em todo o projeto (Rápido)
npm run typecheck || { echo "❌ Falha na verificação de tipos (typecheck)."; exit 1; }

# 3. Lint
npm run lint || { echo "❌ Lint falhou."; exit 1; }

# 4. Testes unitários (Rápido)
npm run test || { echo "❌ Testes unitários falharam."; exit 1; }

# 5. Auditoria de segurança de dependências (Rápido)
npm run security:audit || { echo "❌ Vulnerabilidades de segurança encontradas."; exit 1; }

# 6. Build de produção do Next.js
npm run build || { echo "❌ Falha ao compilar a build do Next.js."; exit 1; }

echo "🚀 Tudo verificado, testado e buildado com sucesso! Autorizando push."
