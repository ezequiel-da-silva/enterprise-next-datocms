{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "bash .cursor/hooks/post-edit-quality.sh"
      }
    ],
    "stop": [
      {
        "command": "bash .cursor/hooks/agent-stop-checklist.sh"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/shell-guard.mjs",
        "failClosed": true
      }
    ]
  }
}
