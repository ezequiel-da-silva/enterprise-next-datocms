{
  "name": "next-dato",
  "version": "0.11.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "start:prod": "NODE_ENV=production next start",
    "start:standalone": "node scripts/serve-standalone.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen": "dotenv -e .env --cascade -- graphql-codegen --config codegen-schema.yml && dotenv -e .env --cascade -- graphql-codegen --config codegen-operations.yml && node scripts/fix-codegen-import.mjs",
    "codegen:check": "node scripts/codegen-check.mjs",
    "check-all": "npm run typecheck && npm run test && npm run lint && npm run build",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:audit:all": "npm audit --audit-level=high",
    "security:headers": "node scripts/check-security-headers.mjs",
    "security:check": "npm run security:audit && npm run security:headers",
    "lighthouse:ci": "lhci autorun",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@datocms/cda-client": "^0.2.10",
    "@datocms/cma-client-node": "^5.7.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "next": "^16.2.12",
    "postcss": "^8.5.25",
    "react": "19.2.4",
    "react-datocms": "^8.0.2",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "chalk": "4.1.2",
    "datocms": "^4.0.29",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "graphql": "^16.13.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.25",
      "sharp": "^0.35.3"
    },
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "lodash": "^4.17.21",
    "nanoid": "^3.3.18",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "chalk": "4.1.2"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "vitest related --run"
    ]
  }
}
