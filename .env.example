# ==========================================
# SEO & Site Metadata
# ==========================================
# URL pública do site (canonical, JSON-LD, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: nome/descrição se Preferências de SEO do Dato estiverem vazias
# (fonte de verdade: _site.globalSeo + Navigation logo/socialLinks)
# NEXT_PUBLIC_SITE_NAME=next-dato
# NEXT_PUBLIC_SITE_DESCRIPTION=

# ==========================================
# DatoCMS Configuration
# ==========================================
# Next.js / Vercel / codegen: tokens CDA (e CMA só para user reviews).
# A CLI (`npx datocms`) NÃO usa estas variáveis: usa OAuth (`npx datocms login`)
# + datocms.config.json. Não substituas DATOCMS_API_TOKEN por um token CMA.
# Passo a passo: docs/DATOCMS.md
#
# DatoCMS — Content Delivery API (conteúdo publicado)
DATOCMS_API_TOKEN=

# Token CDA com rascunhos — Draft Mode e previews
DATOCMS_DRAFT_CDA_TOKEN=

# Token CMA (nome histórico `*_CDA_*`): user reviews em draft e upsert de `product_page` no webhook Shopify.
# O valor tem de ter Access the Content Management API + permissão de Editor nos dois modelos.
DATOCMS_USER_REVIEWS_CDA_TOKEN=

# Secret partilhado com Web Previews / ?secret= na query
DATOCMS_PREVIEW_SECRET=

# Secret do webhook de cache (POST /api/revalidate). Não reutilizar o preview secret.
DATOCMS_REVALIDATE_SECRET=

# Admin Dato para Content Link / Visual Editing
NEXT_PUBLIC_DATOCMS_BASE_EDITING_URL=https://your-project.admin.datocms.com

# Opcional: ancestor do iframe de preview (CSP frame-ancestors)
# DATOCMS_ADMIN_FRAME_ANCESTOR=https://your-project.admin.datocms.com

# Opcional: GraphQL em preview
# DATOCMS_PREVIEW_GRAPHQL_URL=

# Opcional para CDA; **obrigatório** no webhook Shopify (`POST /api/webhooks/shopify`).
# Sem isto o CMA de `product_page` iria para o primary `main`. Até promoveres
# develop → main, usa:
DATOCMS_ENVIRONMENT=develop

# ==========================================
# CI/CD & Integrations
# ==========================================
# GitHub App Token para comentários automáticos do Lighthouse CI no PR
# (Configure este token em Settings > Secrets and variables > Actions no GitHub)
LHCI_GITHUB_APP_TOKEN=

# ==========================================
# Security & Contact
# ==========================================
# Opcional: só para npm run security:headers (se diferente do preview secret)
# SECURITY_TEST_SECRET=

# Opcional: URL alvo dos testes de headers (default http://127.0.0.1:3000)
# SECURITY_BASE_URL=http://127.0.0.1:3000

# Opcional: webhook para envio do formulário de contacto (POST JSON)
# CONTACT_WEBHOOK_URL=

# ==========================================
# Shopify (Dev Dashboard — sem Admin token legado)
# Passo a passo: docs/SHOPIFY.md. Todas privadas na Vercel (sem NEXT_PUBLIC_*).
# ==========================================
# ID do cliente da app (Configurações do app no Dev Dashboard).
SHOPIFY_CLIENT_ID=

# Chave secreta da app — HMAC de POST /api/webhooks/shopify (`x-shopify-hmac-sha256`).
SHOPIFY_API_SECRET_KEY=shpss_

# Loja (sem protocolo). Também valida o header x-shopify-shop-domain no webhook.
SHOPIFY_STORE_DOMAIN=teste-datocms-ezequiel.myshopify.com

# Storefront API no **servidor** (PDP RSC). Não uses NEXT_PUBLIC_*.
# Preferir o token **privado** do canal Headless (`shpat_…`). O público (hex)
# também funciona, mas é o token de cliente. HMAC do webhook usa
# SHOPIFY_API_SECRET_KEY (Dev Dashboard), não este valor.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=