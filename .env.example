# ==========================================
# Ambientes & Convenções
# ==========================================
# `.env` = Staging / Local Default (dev, build, pre-push, codegen).
# `.env.prod` = Produção (utilizado via `npm run dev:prod` / `build:prod`).
# Não utilize `.env.production`: o Next.js carrega-o automaticamente em todo `next build`.

# ==========================================
# SEO & Site Metadata
# ==========================================
# URL pública do site (utilizada para canonical, JSON-LD, sitemap e OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: nome/descrição fallback caso as Preferências Globais de SEO no DatoCMS estejam vazias
# NEXT_PUBLIC_SITE_NAME="Minha Loja"
# NEXT_PUBLIC_SITE_DESCRIPTION="Descrição do e-commerce"

# Merchant Listings & Rich Results (Google Product JSON-LD)
# As políticas TÊM de corresponder ao checkout da Shopify e às páginas formais de política.
# Formato do frete: PAIS:VALOR_NA_MOEDA_LOCAL (ex: BR:0 para Frete Grátis no BR, US:9.90 USD nos EUA)
SEO_SHIPPING_RATES=BR:0,US:9.90,ES:5
SEO_SHIPPING_HANDLING_DAYS=1-2
SEO_SHIPPING_TRANSIT_DAYS=3-7
SEO_RETURN_DAYS=30
SEO_RETURN_FEES=free   # Opções válidas: free | customer | original_shipping_async

# ==========================================
# DatoCMS Configuration
# ==========================================
# DatoCMS — Content Delivery API (conteúdo publicado)
DATOCMS_API_TOKEN=

# Token CDA com rascunhos ativados — Draft Mode e Previews
DATOCMS_DRAFT_CDA_TOKEN=

# Token CMA: gerenciamento de avaliações (user reviews) e revalidação
DATOCMS_USER_REVIEWS_CDA_TOKEN=

# Segredo compartilhado para Web Previews (?secret= na query)
DATOCMS_PREVIEW_SECRET=

# Segredo para webhook de invalidação de cache (POST /api/revalidate)
# Gerar via: openssl rand -base64 32
DATOCMS_REVALIDATE_SECRET=

# URL Base do Painel DatoCMS para Content Link / Visual Editing
NEXT_PUBLIC_DATOCMS_BASE_EDITING_URL=https://your-project.admin.datocms.com

# Opcionais do DatoCMS
# DATOCMS_ADMIN_FRAME_ANCESTOR=https://your-project.admin.datocms.com
# DATOCMS_PREVIEW_GRAPHQL_URL=
# DATOCMS_ENVIRONMENT=main

# ==========================================
# Shopify (Dev Dashboard & Storefront API)
# ==========================================
# ID do Cliente da App (Configurações do app no Dev Dashboard)
SHOPIFY_CLIENT_ID=

# Chave secreta da App — Utilizada na verificação do HMAC em POST /api/webhooks/shopify
SHOPIFY_API_SECRET_KEY=shpss_

# Domínio myshopify da loja (sem protocolo)
SHOPIFY_STORE_DOMAIN=teste-datocms-ezequiel.myshopify.com

# Storefront API Access Token no Servidor (Canal Headless)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Admin API (Opcional - Gerado dinamicamente via Client Credentials se omitido)
# SHOPIFY_ADMIN_ACCESS_TOKEN=

# Recursos de Carrinho & Checkout (Storefront Cart API)
SHOPIFY_CART_ENABLED=true

# Opcional: Domínio customizado de checkout (sem protocolo)
# SHOPIFY_CHECKOUT_DOMAIN=checkout.seudominio.com

# Conta de Cliente (Customer Account API - OAuth PKCE)
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Chave aleatória de 32+ caracteres para cifrar os cookies de sessão (openssl rand -base64 32)
SHOPIFY_CUSTOMER_SESSION_SECRET=

# Opcional: Customer Privacy API (banner de cookies → Shopify). Token PÚBLICO do canal Headless
# (Storefront API → token público), NUNCA o privado shpat_. Vai para o browser como prop do layout,
# por isso não leva NEXT_PUBLIC_. Vazio = o consentimento fica só no cookie nd-consent.
# SHOPIFY_STOREFRONT_PUBLIC_TOKEN=

# ==========================================
# Analytics (só carrega depois de "Aceitar todos" no banner de cookies)
# ==========================================
# GA4 Measurement ID (G-XXXXXXX). Vazio = sem GA e sem hosts Google na CSP.
# GA_MEASUREMENT_ID=

# Vercel Speed Insights (Web Vitals reais, só depois do aceite). Liga sozinho com VERCEL=1; ative também
# em Vercel → Projeto → Speed Insights → Enable, senão /_vercel/speed-insights/script.js dá 404.
# 1/true força ligado (ex.: outro host), 0/false força desligado.
# SPEED_INSIGHTS_ENABLED=

# ==========================================
# Infraestrutura, Segurança & Rate Limiting
# ==========================================
# Rate Limit Distribuído (Upstash Redis / Vercel KV)
# Criado automaticamente ao conectar 'Storage -> Upstash Redis' no painel Vercel.
# Se omitido, o sistema utilizará limite em memória local (fallback para dev/CI).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel KV (Nomes de variáveis nativos criados pela Vercel, também aceitos)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Opcional: Webhook para recebimento de formulário de contato (POST JSON)
# CONTACT_WEBHOOK_URL=

# Opcional: Testes de cabeçalhos de segurança local
# SECURITY_TEST_SECRET=
# SECURITY_BASE_URL=http://127.0.0.1:3000

# ==========================================
# CI/CD & Observabilidade / Analytics (Futuro)
# ==========================================
# Token do GitHub App para comentários do Lighthouse CI nos Pull Requests
LHCI_GITHUB_APP_TOKEN=

# Vercel Analytics & Speed Insights (Habilitados em Produção via Vercel Dashboard)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=